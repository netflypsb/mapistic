# Mapistic — OSS example configuration
# Copy to apps/web/.env.local (or your process manager env) and fill in real values.
# NEVER put real API keys in files committed to git.

# --- Map application database (required for saved places / POI edits) ---
# Any Postgres 17+ with PostGIS 3.5. Neon is the recommended hosted option.
DATABASE_URL="postgresql://user:password@host:5432/mapistic?sslmode=require"

# --- Basemap (required) ---
# Default = OpenFreeMap free vector tiles (no key needed). Optionally self-host.
NEXT_PUBLIC_OFM_TILES_URL="https://tiles.openfreemap.org/planet"

# --- Routing (required for turn-by-turn) ---
# Self-hosted OSRM or GraphHopper (GraphHopper preferred: per-request custom models).
# Valhalla-compatible HTTP routing endpoint used by packages/geo-my.
VALHALLA_INTERNAL_URL="http://localhost:8002"
# See docs/SELF-HOSTING.md for server build instructions.

# --- Geocoder (required for search without MYmap) ---
# Self-hosted Photon. See docs/SELF-HOSTING.md.
PHOTON_INTERNAL_URL="http://localhost:2322"
# Set MAPISTIC_FIXTURES=1 INSTEAD of the URL to run offline on bundled fixtures (tests/demo).
# MAPISTIC_FIXTURES=1

# --- Optional: MYmap hosted Malaysia data layer (preferred provider if set) ---
# Request a key at https://mymap.dawnistic.com — metered per call in credits.
# Leave unset to run fully self-hosted (Photon geocoder only).
# MYMAP_API_URL="https://mymap.dawnistic.com"
# MYMAP_API_KEY="my_keyid_yoursecret"

# --- Optional: identity service (Better Auth compatible) for accounts/saved lists ---
# Unset = app runs without account features (no sign-in, saved lists disabled).
# HUB_URL="https://your-identity-service.example.com"
# NEXT_PUBLIC_HUB_URL="https://your-identity-service.example.com"
# DAWNISTIC_SESSION_ENDPOINT=""            # override the get-session path if needed

# --- Public URL of this deployment ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Rate limiting (optional) ---
# In-memory by default; point at Redis for multi-instance deploys.
# RATE_LIMIT_REDIS_URL="redis://localhost:6379/0"

# --- Malaysia official transit feeds (public, no key) ---
DATA_GOV_MY_GTFS_REALTIME_URL="https://api.data.gov.my/gtfs-realtime/vehicle-position/ktmb/"